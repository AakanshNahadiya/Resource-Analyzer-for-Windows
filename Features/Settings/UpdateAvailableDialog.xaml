<Window x:Class="ResourceAnalyzer.Views.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Update Available - Resource Analyzer for Windows"
        Height="360" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1E293B"
        Foreground="#F8FAFC"
        FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title & Version Info -->
        <TextBlock x:Name="txtTitle" Grid.Row="0" FontWeight="Bold" FontSize="16" Foreground="#38BDF8"
                   Text="A New Update is Available!"
                   AutomationProperties.Name="A New Update is Available"/>

        <TextBlock x:Name="txtVersionInfo" Grid.Row="1" Margin="0,8,0,0" Foreground="#F8FAFC" TextWrapping="Wrap"
                   Text="A new version of Resource Analyzer for Windows is ready to install."/>

        <!-- Release Notes / Details -->
        <ScrollViewer Grid.Row="2" Margin="0,12,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="#0F172A" Padding="10">
            <TextBlock x:Name="txtReleaseNotes" Foreground="#94A3B8" TextWrapping="Wrap"
                       Text="Release details will appear here."
                       AutomationProperties.Name="Release Notes"/>
        </ScrollViewer>

        <!-- Download Status and Progress -->
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock x:Name="txtDownloadStatus" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"
                       Text="Would you like to download and install this update now?"
                       AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar x:Name="pbDownload" Height="8" Minimum="0" Maximum="100" Value="0"
                         Visibility="Collapsed" Background="#334155" Foreground="#38BDF8"/>
        </StackPanel>

        <!-- Two Clear Options: Download and Install, Not Now -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnDownloadInstall" Content="Download and Install" Height="34" Padding="16,4" Margin="0,0,10,0"
                    Click="BtnDownloadInstall_Click"
                    Background="#0284C7" Foreground="White" BorderBrush="#0284C7" FontWeight="SemiBold"
                    AutomationProperties.Name="Download and Install"/>
            <Button x:Name="btnNotNow" Content="Not Now" Width="100" Height="34"
                    Click="BtnNotNow_Click"
                    Background="#334155" Foreground="White" BorderBrush="#475569"
                    AutomationProperties.Name="Not Now"/>
        </StackPanel>
    </Grid>
</Window>
