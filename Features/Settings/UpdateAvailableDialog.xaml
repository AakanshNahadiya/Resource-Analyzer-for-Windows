<Window x:Class="ResourceAnalyzer.Views.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Update - Resource Analyzer for Windows"
        Height="380" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1E293B"
        Foreground="#F8FAFC"
        FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title & Version Info -->
        <TextBlock x:Name="txtTitle" Grid.Row="0" FontWeight="Bold" FontSize="16" Foreground="#38BDF8"
                   Text="Resource Analyzer Update Check"/>

        <TextBlock x:Name="txtVersionInfo" Grid.Row="1" Margin="0,8,0,0" Foreground="#F8FAFC" TextWrapping="Wrap"
                   Text="Checking update details..."/>

        <!-- Release Notes / Details (Only shown when an update is available) -->
        <ScrollViewer x:Name="scrollReleaseNotes" Grid.Row="2" Margin="0,12,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="#0F172A" Padding="10">
            <TextBlock x:Name="txtReleaseNotes" Foreground="#94A3B8" TextWrapping="Wrap"
                       Text="Release details will appear here."
                       AutomationProperties.Name="Release Notes Details"/>
        </ScrollViewer>

        <!-- Download Status and Progress (Only shown when an update is available) -->
        <StackPanel x:Name="pnlDownloadProgress" Grid.Row="3" Margin="0,0,0,14">
            <TextBlock x:Name="txtDownloadStatus" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"
                       Text="Would you like to download and install this update now?"
                       AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar x:Name="pbDownload" Height="8" Minimum="0" Maximum="100" Value="0"
                         Visibility="Collapsed" Background="#334155" Foreground="#38BDF8"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Buttons for Update Available: Download and Install, See What's New, Not Now -->
            <Button x:Name="btnDownloadInstall" Content="Download and Install" Height="34" Padding="16,4" Margin="0,0,10,0"
                    Click="BtnDownloadInstall_Click"
                    Background="#0284C7" Foreground="White" BorderBrush="#0284C7" FontWeight="SemiBold"
                    AutomationProperties.Name="Download and Install"/>
            <Button x:Name="btnSeeWhatsNew" Content="See What's New" Height="34" Padding="14,4" Margin="0,0,10,0"
                    Click="BtnSeeWhatsNew_Click"
                    Background="#334155" Foreground="White" BorderBrush="#475569"
                    AutomationProperties.Name="See What's New on GitHub"/>
            <Button x:Name="btnNotNow" Content="Not Now" Width="100" Height="34" Margin="0,0,10,0"
                    Click="BtnNotNow_Click"
                    Background="#334155" Foreground="White" BorderBrush="#475569"
                    AutomationProperties.Name="Not Now"/>

            <!-- Buttons for Up to Date: View Release Notes, Close -->
            <Button x:Name="btnViewReleaseNotes" Content="View Release Notes" Height="34" Padding="14,4" Margin="0,0,10,0"
                    Click="BtnViewReleaseNotes_Click" Visibility="Collapsed"
                    Background="#334155" Foreground="White" BorderBrush="#475569"
                    AutomationProperties.Name="View Release Notes on GitHub"/>
            <Button x:Name="btnClose" Content="Close" Width="100" Height="34"
                    Click="BtnClose_Click" Visibility="Collapsed"
                    Background="#334155" Foreground="White" BorderBrush="#475569" IsCancel="True"
                    AutomationProperties.Name="Close"/>
        </StackPanel>
    </Grid>
</Window>
