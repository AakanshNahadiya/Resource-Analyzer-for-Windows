<Window x:Class="AccessibleTaskManager.Views.ConfirmEndTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="End Task Confirmation"
        Height="220" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1E293B"
        Foreground="#F8FAFC"
        FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtPrompt" Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="Are you sure you want to end this process?"
                   AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"/>

        <TextBlock Grid.Row="1" Margin="0,8,0,0" Foreground="#94A3B8" TextWrapping="Wrap"
                   Text="Ending a process can cause unstable system state or unsaved data loss."/>

        <CheckBox x:Name="chkDontAskAgain" Grid.Row="2" Margin="0,15,0,0" VerticalAlignment="Top"
                  Foreground="#E2E8F0"
                  Content="Don't ask for confirmation in the future"
                  AutomationProperties.Name="Don't ask for confirmation in the future"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnEndTask" Content="End Task" Width="100" Height="32" Margin="0,0,10,0"
                    IsDefault="True" Click="BtnEndTask_Click"
                    Background="#EF4444" Foreground="White" BorderBrush="#DC2626" FontWeight="SemiBold"
                    AutomationProperties.Name="End Task (Press Enter)"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="90" Height="32"
                    IsCancel="True" Click="BtnCancel_Click"
                    Background="#334155" Foreground="White" BorderBrush="#475569"
                    AutomationProperties.Name="Cancel (Press Escape)"/>
        </StackPanel>
    </Grid>
</Window>
