<Application x:Class="AccessibleTaskManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AccessibleTaskManager">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0284C7"/>
        <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#0284C7"/>
        <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="InputForegroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#475569"/>
        <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="#334155"/>
        <SolidColorBrush x:Key="StatusAnnouncementBrush" Color="#38BDF8"/>
    </Application.Resources>
</Application>
